# ── Database (PostgreSQL) ─────────────────────────────
# Free options: Neon (neon.tech) or Supabase (supabase.com)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Security ──────────────────────────────────────────
# Generate each with:  openssl rand -base64 32
AUTH_SECRET=""
# Encrypts stored credentials. Must decode to exactly 32 bytes.
# NEVER change it after you've added credentials, or they can't be decrypted.
ENCRYPTION_KEY=""

# ── Site ──────────────────────────────────────────────
# Your live address, no trailing slash (e.g. https://deedeesmarketplace.com)
APP_URL="http://localhost:3000"

# ── Daily job (auto-confirm orders) ───────────────────
# Any long random string. Vercel sends it to /api/cron/daily.
CRON_SECRET=""

# ── First admin account (used by `npm run db:seed`) ───
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_PHONE="09035206681"
