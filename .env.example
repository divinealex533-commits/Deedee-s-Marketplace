# ── Database (PostgreSQL) ─────────────────────────────
# Free options: Neon (neon.tech) or Supabase (supabase.com)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Security ──────────────────────────────────────────
# Generate each with:  openssl rand -base64 32
AUTH_SECRET=""
# Encrypts stored credentials. Must decode to exactly 32 bytes.
# NEVER change it after you've added credentials, or they can't be decrypted.
ENCRYPTION_KEY=""

# ── Site ──────────────────────────────────────────────
# Your live address, no trailing slash (e.g. https://deedeesmarketplace.com)
APP_URL="http://localhost:3000"

# ── Termii (SMS verification codes) ───────────────────
# Leave TERMII_API_KEY empty while testing: codes are printed in the server log.
TERMII_API_KEY=""
TERMII_SENDER_ID="DeeDees"
TERMII_BASE_URL="https://v3.api.termii.com"
# "generic" or "dnd" (dnd reaches numbers on Do-Not-Disturb; ask Termii to activate it)
TERMII_CHANNEL="generic"

# ── First admin account (used by `npm run db:seed`) ───
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"
ADMIN_PHONE="09035206681"
