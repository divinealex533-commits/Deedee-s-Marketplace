generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  BUYER
  SELLER
}

enum OtpPurpose {
  SIGNUP
  RESET
}

enum CredentialStatus {
  AVAILABLE
  /// Held for a checkout that is waiting for payment / approval
  RESERVED
  SOLD
}

enum CheckoutStatus {
  AWAITING_PAYMENT
  UNDER_REVIEW
  COMPLETED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  ESCROW
  COMPLETED
  DISPUTED
  REFUNDED
}

enum TxType {
  FUNDING
  PURCHASE
  REFUND
  ADJUSTMENT
  REFERRAL
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Money a seller earns from one sale; the admin approves it before the seller can withdraw.
enum EarningStatus {
  PENDING
  APPROVED
  /// The order was refunded or the admin rejected it
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED
}

enum TxStatus {
  PENDING
  SUCCESS
  FAILED
}

/// All money is stored in kobo (₦1 = 100 kobo) to avoid rounding errors.
model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  phone         String        @unique
  passwordHash  String
  role          Role          @default(USER)
  accountType   AccountType   @default(BUYER)
  phoneVerified Boolean       @default(false)
  banned        Boolean       @default(false)
  balance       Int           @default(0)
  referralCode  String        @unique
  referredById  String?
  referredBy    User?         @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]        @relation("Referrals")
  /// true once this user's referrer has been paid the referral bonus
  referralBonusPaid Boolean   @default(false)
  /// Raised on password change, reset or "log out everywhere": older login cookies stop working.
  sessionVersion Int          @default(0)
  /// Wrong-password counter and temporary lock (stops password guessing).
  failedLogins  Int           @default(0)
  lockedUntil   DateTime?
  reviews       Review[]
  orders        Order[]
  transactions  Transaction[]
  deposits      Deposit[]
  apiKeys       ApiKey[]
  checkouts     Checkout[]
  /// Sellers: their shop is open (listings visible) until this date. Paid monthly.
  sellerUntil   DateTime?
  /// Sellers: approved earnings available to withdraw (kobo)
  sellerBalance Int           @default(0)
  /// Sellers: bank account their withdrawals are paid into
  payoutBank        String?
  payoutAccountName String?
  payoutAccountNumber String?
  sellerListings     Listing[]            @relation("SellerListings")
  sellerSubscriptions SellerSubscription[]
  sellerEarnings     SellerEarning[]
  withdrawals        Withdrawal[]
  createdAt     DateTime      @default(now())

  @@index([createdAt])
}

model Otp {
  id        String     @id @default(cuid())
  phone     String
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
}

/// A product in the shop, e.g. "Instagram 5K fashion page".
/// Its stock is the number of AVAILABLE credentials attached to it.
model Listing {
  id          String       @id @default(cuid())
  platform    String
  title       String
  description String       @default("")
  price       Int
  active      Boolean      @default(true)
  /// true: customers see each login (e.g. phone number) before buying; false: they see it partly hidden
  showLogin   Boolean      @default(false)
  /// Set when an image is uploaded; used to refresh cached images
  imageAt     DateTime?
  image       ListingImage?
  reviews     Review[]
  checkouts   Checkout[]
  credentials Credential[]
  orders      Order[]
  /// Set for listings created by a seller (empty = the shop's own listing)
  sellerId    String?
  seller      User?        @relation("SellerListings", fields: [sellerId], references: [id])
  /// true when hidden automatically because the seller's monthly plan ran out
  pausedExpired Boolean    @default(false)
  earnings    SellerEarning[]
  createdAt   DateTime     @default(now())

  @@index([sellerId])
}

/// Kept in its own table so listing queries don't load image bytes.
model ListingImage {
  listingId String  @id
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  data      Bytes
  type      String
}

/// One account login in the pool. Password and notes are AES-256-GCM encrypted.
model Credential {
  id        String           @id @default(cuid())
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  login     String
  /// Optional public link customers can open before buying (e.g. the profile page)
  previewUrl String?
  secretEnc String
  status    CredentialStatus @default(AVAILABLE)
  checkoutId String?
  checkout  Checkout?        @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  order     Order?
  createdAt DateTime         @default(now())

  @@index([listingId, status])
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  listingId    String
  listing      Listing     @relation(fields: [listingId], references: [id])
  credentialId String      @unique
  credential   Credential  @relation(fields: [credentialId], references: [id])
  amount       Int
  checkoutId   String?
  checkout     Checkout?   @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  status       OrderStatus @default(ESCROW)
  earning      SellerEarning?
  confirmedAt  DateTime?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        TxType
  status      TxStatus @default(SUCCESS)
  /// Positive = money in, negative = money out (kobo).
  amount      Int
  reference   String?  @unique
  description String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

/// One row per visitor per day (Lagos time), for the admin "visitors today" count.
model Visit {
  id        String   @id @default(cuid())
  visitorId String
  day       String
  path      String
  hits      Int      @default(1)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([visitorId, day])
  @@index([day])
  @@index([lastSeen])
}

/// A bank account customers can transfer to (e.g. 9PSB, PocketApp). Managed from Admin → Bank accounts.
model BankAccount {
  id            String    @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  active        Boolean   @default(true)
  deposits      Deposit[]
  checkouts     Checkout[]
  sellerSubscriptions SellerSubscription[]
  createdAt     DateTime  @default(now())
}

/// A customer's "I've paid" claim with a screenshot. Admin approves it to credit the wallet.
model Deposit {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  bankAccountId  String?
  bankAccount    BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  /// Amount the customer says they sent (kobo)
  amount         Int
  /// Amount actually credited after review (kobo)
  approvedAmount Int?
  senderName     String
  note           String        @default("")
  /// Screenshot, compressed in the browser before upload
  proof          Bytes
  proofType      String
  status         DepositStatus @default(PENDING)
  reviewNote     String        @default("")
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Reseller API key. Only a SHA-256 hash is stored; the full key is shown once when created.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// First characters of the key, shown in the dashboard so you can tell keys apart
  prefix     String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Simple site settings edited from Admin → Settings (e.g. the announcement bar).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A customer's rating. Either written by a buyer on the site (userId set, one per listing),
/// or real feedback the admin received on WhatsApp and added with permission (source = "whatsapp").
model Review {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// Name shown for feedback added by the admin (site reviews use the account name)
  authorName String?
  source     String   @default("site")
  rating     Int
  comment   String   @default("")
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, listingId])
  @@index([listingId, hidden])
  @@index([createdAt])
}

/// "Buy now → Checkout": the customer pays this order by bank transfer and uploads a receipt.
/// The chosen logins are RESERVED until payment is approved (then SOLD) or the checkout ends.
model Checkout {
  id            String         @id @default(cuid())
  /// Short code the customer puts in the transfer narration, e.g. DD7K2Q
  reference     String         @unique
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  listingId     String
  listing       Listing        @relation(fields: [listingId], references: [id])
  quantity      Int
  unitPrice     Int
  amount        Int
  status        CheckoutStatus @default(AWAITING_PAYMENT)
  bankAccountId String?
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  senderName    String?
  proof         Bytes?
  proofType     String?
  rejectReason  String         @default("")
  expiresAt     DateTime
  paidAt        DateTime?
  reviewedAt    DateTime?
  credentials   Credential[]
  orders        Order[]
  createdAt     DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// A seller's monthly plan payment (bank transfer + receipt). Approving it opens their shop for 30 days.
model SellerSubscription {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  bankAccountId String?
  bankAccount   BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  amount        Int
  senderName    String
  proof         Bytes
  proofType     String
  status        DepositStatus @default(PENDING)
  reviewNote    String        @default("")
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// What a seller earns from one sold item: the price minus the shop's commission.
model SellerEarning {
  id         String        @id @default(cuid())
  sellerId   String
  seller     User          @relation(fields: [sellerId], references: [id])
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id])
  listingId  String
  listing    Listing       @relation(fields: [listingId], references: [id])
  /// Sale price, commission and what the seller gets (kobo)
  gross      Int
  commission Int
  amount     Int
  status     EarningStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
}

/// A seller asks to be paid their approved earnings into their bank account.
model Withdrawal {
  id            String           @id @default(cuid())
  sellerId      String
  seller        User             @relation(fields: [sellerId], references: [id])
  amount        Int
  bankName      String
  accountName   String
  accountNumber String
  status        WithdrawalStatus @default(PENDING)
  reviewNote    String           @default("")
  reviewedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
}
